   "source": [
    "# ML-5: Gradient Descent\n",
    "\n",
    "Find the minimum of `y = (x + 3)^2`, starting from `x = 2`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "94b00b89",
   "metadata": {},
   "outputs": [],
   "source": [
    "x = 2\n",
    "learning_rate = 0.1\n",
    "\n",
    "for i in range(100):\n",
    "    gradient = 2 * (x + 3)\n",
    "    x = x - learning_rate * gradient\n",
    "\n",
    "print('Local minimum x:', x)\n",
    "print('Minimum y:', (x + 3) ** 2)"
   ]
  }
 ],
